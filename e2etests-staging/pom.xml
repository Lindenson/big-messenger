<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.hormigas</groupId>
  <artifactId>messenger-e2e-staging</artifactId>
  <version>1.0.0-SNAPSHOT</version>

  <!--
    Staging/preprod Karate smoke suite for the Messenger service.
    Runs against https://hormi.isolutions.io/messenger behind Cloudflare + Ory
    Oathkeeper + Kratos. Auth is handled by the karate-authflow plugin (Ory Kratos
    session cookie) — feature files carry no auth steps.

    Run:
      mvn -f e2etests-staging/pom.xml test \
        -Dkratos.email=<email> -Dkratos.password=<password>
  -->

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <karate.version>1.5.2</karate.version>
    <junit5.version>5.10.2</junit5.version>
    <authflow.version>0.1.0-SNAPSHOT</authflow.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.karatelabs</groupId>
      <artifactId>karate-junit5</artifactId>
      <version>${karate.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.lindenson</groupId>
      <artifactId>karate-authflow</artifactId>
      <version>${authflow.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit5.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <testResources>
      <testResource>
        <directory>src/test/java</directory>
        <excludes><exclude>**/*.java</exclude></excludes>
      </testResource>
      <testResource>
        <directory>src/test/resources</directory>
      </testResource>
    </testResources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>
    </plugins>
  </build>
</project>
