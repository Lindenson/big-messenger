###############################################################################
# HormigaMessanger — runtime environment.
#   cp docker/.env.example docker/.env   then edit for your environment.
# Every value here has a sane default in application.yaml; set a var to point the
# service at your EXTERNAL dependencies (or leave blank to use the bundled ones in
# docker-compose.yml). NEVER commit a filled-in .env — it holds secrets.
###############################################################################

# ── PostgreSQL (durable store: outbox + message history + conversations) ─────
DB_HOST=postgres              # external DB host (compose service name = postgres)
DB_PORT=5432
DB_NAME=hormigasdb
DB_USER=ant
DB_PASSWORD=change-me         # SECRET — set a real password in prod
# Two isolated reactive pools over the SAME Postgres (persist writes vs outbox poller).
# Total connections = persist + poller; keep persist ≥ processing.messages.*.max-concurrent-batches.
DB_POOL_PERSIST=24
DB_POOL_POLLER=12

# ── Redis (presence · Tetris watermark GC · idempotency dedup) ───────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── MinIO / S3 (attachment object store, two-phase presigned upload) ─────────
# IMPORTANT: MINIO_ENDPOINT is handed to CLIENTS in presigned URLs (split-horizon) —
# it must be a host the clients can also reach, not an internal-only name.
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=hormiga
MINIO_SECRET_KEY=change-me    # SECRET
MINIO_BUCKET=messenger-attachments

# ── Kafka (inbound order.events; OPTIONAL — absent broker boots fine, retries) ─
# Not provisioned yet on the Order side; readiness for it is disabled in config.
# Set to the real broker when available, e.g. broker:29092.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_FILE=/var/log/messenger/messenger.log   # rotated 20M×10; mount a volume here

# ── JVM footprint guards (set on the container; see docker/README.md) ─────────
# Baked into the image already; override only if you change the memory limit.
# MALLOC_ARENA_MAX=2
# JAVA_OPTS=-Dquarkus.http.host=0.0.0.0 -XX:+UseG1GC -Xmx2g -XX:MaxDirectMemorySize=1g -XX:MaxMetaspaceSize=256m -XX:ReservedCodeCacheSize=256m
